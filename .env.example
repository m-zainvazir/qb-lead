# Variable names only. Copy to .env and fill in locally (`make env` does this for the
# local Supabase stack). Staging/production values live in the host's secret store.

# --- Shared (API + worker) ---
APP_ENV=                      # local | staging | production
LOG_LEVEL=                    # INFO by default
GIT_COMMIT=                   # set by the build; "dev" locally

# Supabase
SUPABASE_URL=                 # e.g. http://127.0.0.1:54321
SUPABASE_ANON_KEY=            # public key
SUPABASE_SERVICE_ROLE_KEY=    # BACKEND ONLY. Never in apps/web.
SUPABASE_JWT_SECRET=          # HS256 fallback when JWKS has no keys (local)

# Postgres (see docs/decisions/0001-db-access.md)
DATABASE_URL_API=             # login role app_api    -> user_db(), RLS applies
DATABASE_URL_SYSTEM=          # login role app_system -> system_db(), worker + admin only
DATABASE_URL_ADMIN=           # superuser; migrations, db-roles, tests. Never in a running service.
APP_DB_PASSWORD=              # password set on app_api by `python -m api.cli db-roles`
SYSTEM_DB_PASSWORD=           # password set on app_system by `python -m api.cli db-roles`

# Redis / Celery
REDIS_PASSWORD=
REDIS_URL=                    # redis://:<password>@localhost:6379/0

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=

# --- Web (apps/web, server-side only; nothing here is NEXT_PUBLIC) ---
WEB_BASE_URL=                 # e.g. http://localhost:3000
API_URL=                      # e.g. http://localhost:8000
